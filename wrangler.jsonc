{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ibuild",
  "main": "src/worker.js",
  "compatibility_date": "2026-08-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "build/web",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  }
}
